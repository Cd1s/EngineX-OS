# Copy to ~/.config/enginex-dev/decks.ini or set DECK_PUSH_CONFIG.
# Addresses and SSH/ssm aliases stay in local configuration, never in Git.
[defaults]
state_dir = /var/lib/enginex-dev
qrc = /root/build/sc5000-lab/5.3.0/qrc
work_dir = /var/tmp

[left]
ssh = local-left-alias
# transport = ssm  # use an exact alias discovered with sshctl list
ssh_options = -o ServerAliveInterval=10
# 5.3.0 JP07/JP08/JP13/JP14; override for other boards (e.g. JP11).
expect_applied = 20
daemons = stream-sync sc5000-deemixd rb-bridge
api_url = http://127.0.0.1:8080/v1/sc5000/ui
smoke_timeout = 180
settle = 15

[right]
ssh = local-right-alias
