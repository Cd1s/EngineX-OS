#!/usr/bin/env python3
"""Acquire deck leases, or run a local/remote command while holding them."""
import importlib.machinery
import importlib.util
import sys
from pathlib import Path

loader = importlib.machinery.SourceFileLoader("deck_push", str(Path(__file__).with_name("deck-push")))
spec = importlib.util.spec_from_loader(loader.name, loader)
dp = importlib.util.module_from_spec(spec)
loader.exec_module(dp)

if __name__ == "__main__":
    sys.exit(dp.lock_main())
