#!/bin/sh
# After three Engine starts that neither survive 15 seconds nor stop cleanly,
# the UI hook stops applying packs (safe-mode) and the deck comes back with the
# stock UI. Deliberate stops and restarts (language switch, deploy) reset it.
UI=${SC5000_UI_DIR:-/data/sc5000-custom/ui}
case ${1:-} in
pre)
    n=$(cat "$UI/boot-count" 2>/dev/null)
    case $n in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1))
    mkdir -p "$UI"
    rm -f "$UI/boot-token"
    echo "$n" > "$UI/boot-count"
    [ "$n" -lt 3 ] || : > "$UI/safe-mode"
    # Engine 5.3.0 sends a TIDAL client with no saved account to the Engine DJ
    # Profile login (#56), and every EngineX service runs on that client. With the
    # account entry (no token in it) Engine logs in to the local gateway at start.
    # Real TIDAL (scope=tidal) keeps the stock login.
    accounts=${SC5000_STREAMING_ACCOUNTS:-/data/StreamingAccounts.json}
    if ! grep -qx 'scope=tidal' "$UI/settings.conf" 2>/dev/null && ! grep -q '"TIDAL"' "$accounts" 2>/dev/null; then
        export T='"TIDAL": "{\"provider\":\"TIDAL\",\"providerType\":\"TIDAL\"}"'
        if grep -q '"' "$accounts" 2>/dev/null; then
            awk '!d && (i = index($0, "{")) { $0 = substr($0, 1, i) "\n    " ENVIRON["T"] "," substr($0, i + 1); d = 1 } 1' "$accounts" > "$accounts.tmp"
        else
            printf '{\n    %s\n}\n' "$T" > "$accounts.tmp"
        fi
        mv "$accounts.tmp" "$accounts"
    fi
    # #49: with the 4-deck layout unlocked (four_deck_waveform=1) Engine stops being a
    # player and names the hardware's deck group "Left"; the players' preset assignment
    # files use the unnamed group, so PLAY, CUE and the wheel would drive no deck. Bind a
    # copy that names it only when Engine is not a player (unchanged on a player).
    assign=${SC5000_ASSIGNMENT_DIR:-/usr/Engine/AssignmentFiles/PresetAssignmentFiles}
    patched=${SC5000_ASSIGNMENT_PATCHED:-/run/sc5000-assignments}
    for f in "$assign"/JP07/JP07_Controller_Assignments.qml "$assign"/JP08/JP08_Controller_Assignments.qml \
        "$assign"/JP13/JP13_Controller_Assignments.qml "$assign"/JP14/JP14_Controller_Assignments.qml; do
        [ -f "$f" ] && ! mountpoint -q "$f" || continue
        mkdir -p "$patched"
        p=$patched/${f##*/}
        sed '/^    DeckAssignmentConfig {$/{n;s/^        id: deckConfig$/&\n        name: Config.device.isPlayer ? "" : "Left"/}' "$f" > "$p"
        if grep -q 'name: Config.device.isPlayer' "$p"; then mount --bind "$p" "$f"; else rm -f "$p"; fi
    done
    ;;
post)
    # Engine's setup script has just set the GPU to performance. This also covers
    # boot, when a start request would merge with an already running tune job.
    /usr/local/bin/sc5000-perf-tune >/dev/null 2>&1
    # Only the timer of the latest start may clear the count, so a timer that
    # outlived its start cannot reset a later crash streak (#7).
    token=$$-$(cat "$UI/boot-count" 2>/dev/null)
    echo "$token" > "$UI/boot-token"
    ( sleep "${SC5000_UI_HEALTHY_AFTER:-15}"
      [ "$(cat "$UI/boot-token" 2>/dev/null)" = "$token" ] && rm -f "$UI/boot-count" "$UI/boot-token"
    ) </dev/null >/dev/null 2>&1 &
    ;;
stop)
    # systemd sets SERVICE_RESULT=success for a requested stop/restart; a crash
    # (exit-code, signal, core-dump, timeout) keeps counting towards safe-mode.
    [ "${SERVICE_RESULT:-}" != success ] || rm -f "$UI/boot-count" "$UI/boot-token"
    # The stock script exits 0 after these quit reasons, so Restart=on-failure never
    # brings Engine back and the deck hangs on "Shutting down...". FactoryReset only
    # gets here without a reboot when az01-update --erase-data failed (not on AC power).
    reason_file=${SC5000_QUIT_REASON_FILE:-/tmp/engine-quit-reason}
    case $(cat "$reason_file" 2>/dev/null) in
    AnalyticsChange) ;;
    FactoryReset) [ "$(systemctl is-system-running 2>/dev/null)" != stopping ] || exit 0 ;;
    *) exit 0 ;;
    esac
    rm -f "$reason_file"
    systemctl start --no-block engine.service >/dev/null 2>&1 || true
    ;;
esac
exit 0
