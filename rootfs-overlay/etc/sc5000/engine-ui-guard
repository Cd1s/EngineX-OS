#!/bin/sh
# The existing safe-mode marker now means a persistent, hook-free stock boot.
# Only a rendered main view may acknowledge an attempt; uptime is not health.
primary_ui=${SC5000_PRIMARY_UI_DIR:-/data/enginex/ui}
legacy_ui=${SC5000_LEGACY_UI_DIR:-/data/sc5000-custom/ui}
UI=${SC5000_UI_DIR:-$primary_ui}
[ -d "$UI" ] || [ ! -d "$legacy_ui" ] || UI=$legacy_ui
guardian=${SC5000_ENGINE_GUARDIAN:-/usr/local/bin/engine-guardian}
limit=${SC5000_BOOT_TIMEOUT:-180}
window=${SC5000_BOOT_CRASH_WINDOW:-300}
failures=${SC5000_BOOT_CRASH_LIMIT:-3}
# Set by this boot's first `pre` (/run is empty at every boot). A stop without it is an instance
# that never started under the guard: on second-generation decks the stock Engine every boot starts
# with, which boot-activate restarts into the hooked one. Its clean stop must not wipe the previous
# boot's crash and power-cut evidence before `pre` reads it (BH-F52-4).
pre_mark=${SC5000_GUARD_PRE_MARK:-/run/sc5000-engine-guard.pre}
case $limit in ''|*[!0-9]*|0) limit=180 ;; esac
case $window in ''|*[!0-9]*|0) window=300 ;; esac
case $failures in ''|*[!0-9]*|0) failures=3 ;; esac
[ "${#limit}" -le 5 ] && [ "$limit" -le 86400 ] || limit=180
[ "${#window}" -le 5 ] && [ "$window" -le 86400 ] || window=300
[ "${#failures}" -le 3 ] && [ "$failures" -le 100 ] || failures=3
poll=${SC5000_BOOT_POLL_INTERVAL:-1}
case $poll in .1|0.1|.5|0.5|1|2|5) ;; *) poll=1 ;; esac
record() {
    mkdir -p "$UI" || return 1
    (umask 077; printf '%s\n' "$2" > "$UI/.$1.$$" && mv -f "$UI/.$1.$$" "$UI/$1")
}
uptime_seconds() { cut -d. -f1 "${SC5000_BOOT_UPTIME:-/proc/uptime}"; }
quarantine() {
    rm -rf "$UI/mods-overlay"
    : > "$UI/mods-quarantined"
    if [ "$UI" != "$primary_ui" ] && [ -d "$primary_ui" ]; then
        rm -rf "$primary_ui/mods-overlay"
        : > "$primary_ui/mods-quarantined"
    fi
    # A fallback during this boot must also undo our earlier assignment binds.
    assign=${SC5000_ASSIGNMENT_DIR:-/usr/Engine/AssignmentFiles/PresetAssignmentFiles}
    patched=${SC5000_ASSIGNMENT_PATCHED:-/run/sc5000-assignments}
    for f in "$assign"/JP0[78]/*Assignments.qml "$assign"/JP1[34]/*Assignments.qml; do
        [ -f "$patched/${f##*/}" ] || continue
        ! mountpoint -q "$f" || umount "$f" || :
    done
}
fallback() {
    case $1 in ui-ready-timeout|crash-loop|previous-fallback) ;; *) return 2 ;; esac
    if [ ! -e "$UI/safe-mode" ]; then
        record boot-stage "$1"
        record safe-mode "$1" || return 1
        rm -f "$UI/boot-report-latest"
    fi
    quarantine
}
begin_attempt() {
    rm -f "${SC5000_QUIT_REASON_FILE:-/tmp/engine-quit-reason}"
    # /proc's boot UUID also distinguishes a stale acknowledgement after a reboot.
    token=$(cat /proc/sys/kernel/random/uuid 2>/dev/null)-$$-$(uptime_seconds)
    rm -f "$UI/boot-ready"
    record boot-started "$(uptime_seconds)"
    record boot-stage engine-start
    record boot-token "$token"
}
case ${1:-} in
runtime)
    [ ! -e "$UI/safe-mode" ] || exit 0
    exec "${SC5000_DEBLOAT:-/usr/local/bin/sc5000-debloat}" --apply-runtime
    ;;
service)
    shift
    [ "$#" -gt 0 ] || exit 2
    unset LD_PRELOAD
    if [ ! -e "$UI/safe-mode" ]; then
        # Arm recovery before loading anything into the vendor launcher. Its
        # updater children still need the hook on a normal EngineX start.
        begin_attempt
        export LD_PRELOAD=${SC5000_UI_HOOK:-/etc/sc5000/libengine-ui-hook.so}
    fi
    exec "$@"
    ;;
launch)
    shift
    [ "$#" -gt 0 ] || exit 2
    unset LD_PRELOAD
    # The stock engine script can retry without restarting engine.service.
    # Count failures at that boundary too, retaining its exit-code/quit contract.
    [ ! -e "$UI/last-crash" ] || "$0" pre
    if [ -e "$UI/safe-mode" ]; then
        quarantine
        exec "$@"
    fi
    begin_attempt
    LD_PRELOAD=${SC5000_UI_HOOK:-/etc/sc5000/libengine-ui-hook.so} "$@" &
    child=$!
    trap 'kill -TERM "$child" 2>/dev/null; wait "$child" 2>/dev/null; exit 143' TERM INT HUP
    wait "$child"; result=$?
    trap - TERM INT HUP
    reason=$(cat "${SC5000_QUIT_REASON_FILE:-/tmp/engine-quit-reason}" 2>/dev/null)
    intentional=
    case $reason in Poweroff|Reboot|UpdateFromLoader|UpdateFromFile|UpdateFromUrl|TestApp|ControllerMode|UpdateFirmware|FactoryReset|AnalyticsChange) intentional=1 ;; esac
    if [ "$result" -ne 0 ] && [ "$result" -ne 7 ] && [ -z "$intentional" ]; then
        : > "$UI/last-crash"
    elif [ "$(cat "$UI/boot-token" 2>/dev/null)" = "$token" ]; then
        # An intentional update/USB-mode handoff can take minutes outside Engine.
        # Disarm this attempt rather than interrupting that vendor operation.
        rm -f "$UI/boot-token" "$UI/boot-ready" "$UI/boot-progress"
    fi
    exit "$result"
    ;;
ready)
    [ ! -e "$UI/safe-mode" ] && [ -n "${2:-}" ] && [ "$(cat "$UI/boot-token" 2>/dev/null)" = "$2" ] || exit 1
    record boot-ready "$2"
    ;;
progress)
    case ${2:-} in prepare|database|media-check|media-convert|media-heal|engine-start|stream-sync) ;; *) exit 2 ;; esac
    case ${3:-} in ''|*[!0-9]*) exit 2 ;; esac
    token=$(cat "$UI/boot-token" 2>/dev/null)
    [ -z "$token" ] || record boot-progress "$token $2 $3"
    ;;
fallback)
    fallback "${2:-ui-ready-timeout}"
    ;;
watch)
    # This replaces the retired database watch in the existing guardian unit.
    # It never opens a library. Progress means completed work, not a heartbeat.
    seen= progress= since=$(uptime_seconds) exported=0
    trap 'exit 0' TERM INT HUP
    while :; do
        now=$(uptime_seconds)
        if [ -e "$UI/safe-mode" ]; then
            if [ "$now" -ge "$exported" ]; then
                exported=$((now + 5))
                if [ -x "$guardian" ]; then
                    "$guardian" --timeout 15s --boot-report --ui-dir "$UI" --mount-root "${SC5000_BOOT_MEDIA_ROOT:-/media}" >/dev/null 2>&1 || :
                fi
            fi
        else
            token=$(cat "$UI/boot-token" 2>/dev/null)
            ready=$(cat "$UI/boot-ready" 2>/dev/null)
            if [ -n "$token" ] && [ "$token" = "$ready" ]; then
                rm -f "$UI/boot-count"
                [ "$(cat "$UI/boot-stage" 2>/dev/null)" = ui-ready ] || record boot-stage ui-ready
            elif [ -n "$token" ]; then
                if [ "$token" != "$seen" ]; then
                    seen=$token; progress=; since=$now
                fi
                current=$(cat "$UI/boot-progress" 2>/dev/null)
                case $current in
                    "$token "*)
                        if [ "$current" != "$progress" ]; then progress=$current; since=$now; fi ;;
                esac
                if [ $((now - since)) -ge "$limit" ] &&
                    [ "$(cat "$UI/boot-token" 2>/dev/null)" = "$token" ] &&
                    [ "$(cat "$UI/boot-ready" 2>/dev/null)" != "$token" ]; then
                    if fallback ui-ready-timeout; then
                        # Do not wait for report generation or restart a unit during shutdown.
                        if [ "$(systemctl is-system-running 2>/dev/null)" != stopping ]; then
                            systemctl reset-failed engine.service >/dev/null 2>&1 || :
                            systemctl restart --no-block engine.service >/dev/null 2>&1 || :
                        fi
                    fi
                fi
            fi
        fi
        sleep "$poll"
    done
    ;;
pre)
    mkdir -p "$UI"
    : > "$pre_mark" 2>/dev/null || :
    # Only a start that follows a crash (the stop hook left last-crash) counts towards
    # safe-mode; a clean start resets the streak, never a persistent fallback.
    # A boot-token still here means the last start never reached its healthy timer and
    # no stop hook ran (hang or hard power-off, #140): count it as a crash too.
    crashed=
    pending=$(cat "$UI/boot-token" 2>/dev/null)
    { [ -e "$UI/last-crash" ] || { [ -n "$pending" ] && [ "$(cat "$UI/boot-ready" 2>/dev/null)" != "$pending" ]; }; } && crashed=1
    now=$(date +%s)
    started=$(cat "$UI/boot-window" 2>/dev/null)
    case $started in ''|*[!0-9]*) started=$now ;; esac
    [ "${#started}" -le 12 ] || started=$now
    count=$(cat "$UI/boot-failures" 2>/dev/null)
    case $count in ''|*[!0-9]*) count=0 ;; esac
    [ "${#count}" -le 6 ] || count=0
    if [ "$now" -lt "$started" ] || [ $((now - started)) -gt "$window" ]; then count=0; started=$now; fi
    if [ -n "$crashed" ]; then
        rm -f "$UI/last-crash"
        count=$((count + 1))
        record boot-failures "$count"
        record boot-window "$started"
        n=$((count + 1))
    else
        n=1
    fi
    # running-sentinel survives only if no stop hook ran (power cut, even after a healthy
    # start): no crash to count, but the cache may be truncated.
    dirty=$crashed; [ ! -e "$UI/running-sentinel" ] || dirty=1
    rm -f "$UI/boot-token" "$UI/boot-ready"
    : > "$UI/running-sentinel"
    echo "$n" > "$UI/boot-count"
    # #140: a .qmlc truncated by a power cut would trap the deck at the splash screen;
    # Qt rebuilds the cache, so drop it after any crash and in safe-mode.
    if [ -n "$dirty" ] || [ "$count" -ge "$failures" ] || [ -e "$UI/safe-mode" ]; then
        rm -rf "${SC5000_ENGINE_DATA_DIR:-/data/AppDataUser/AIR Music Technology/Engine}/.cache/qml"
    fi
    if [ "$count" -ge "$failures" ]; then fallback crash-loop; fi
    if [ -e "$UI/safe-mode" ]; then
        quarantine
        # No EngineX database/account/assignment changes on a stock fallback.
        exit 0
    else
        overlay=$UI/mods-overlay
        if [ ! -d "$overlay" ] && [ -d "$primary_ui/mods-overlay" ]; then
            overlay=$primary_ui/mods-overlay
        fi
        if [ ! -e "$UI/mods-quarantined" ] && [ ! -e "$primary_ui/mods-quarantined" ] && [ -d "$overlay" ]; then
            seen_targets=" "
            for target in "$UI/active" "$primary_ui/active"; do
                [ -d "$target" ] || continue
                case $seen_targets in *" $target "*) continue ;; esac
                seen_targets="$seen_targets$target "
                (
                    cd "$overlay" && find . -type f -name '*.qml' | while IFS= read -r f; do
                        rel=${f#./}
                        mkdir -p "$target/$(dirname "$rel")"
                        cp -p "$overlay/$rel" "$target/$rel"
                    done
                )
            done
        fi
    fi
    # The stock GUI saves only on clean poweroff. Restore the independently
    # persisted stock Lighting choice before every start, including crash restarts.
    lighting_state=false
    if grep -qx 'engine_lighting=1' "$UI/settings.conf" 2>/dev/null; then lighting_state=true; fi
    state_dir=${SC5000_STATE_DIR:-/data/AppDataUser/AIR Music Technology/Engine/State}
    gui_state="$state_dir/PlanckGuiState.json"
    mkdir -p "$state_dir" 2>/dev/null || :
    if [ ! -s "$gui_state" ]; then
        printf '{"data":{"GUI":{"childorder":["SoundSwitchViewEnabled"],"children":{"SoundSwitchViewEnabled":{"state":%s,"type":1}},"type":"Node"}}}\n' "$lighting_state" > "$gui_state.tmp" && mv "$gui_state.tmp" "$gui_state"
    elif grep -q '"GUI"[[:space:]]*:[[:space:]]*{' "$gui_state"; then
        # Token offsets preserve every unrelated byte and scope edits to GUI own
        # children/childorder (Decks has identically named nested containers).
        awk -v state="$lighting_state" '
        function skip(i,    closer) {
            if (tok[i] != "{" && tok[i] != "[") return i + 1
            closer = tok[i] == "{" ? "}" : "]"
            i++
            while (i <= nt && tok[i] != closer) i = skip(i)
            return i + 1
        }
        function member(i, key,    k) {
            if (tok[i] != "{") return 0
            for (k = i + 1; k <= nt && tok[k] != "}";) {
                if (tok[k] == "\"" key "\"" && tok[k+1] == ":") return k+2
                k = skip(k+2)
                if (tok[k] == ",") k++
            }
            return 0
        }
        { a[NR] = $0 }
        END {
            for (line = 1; line <= NR; line++) s = s a[line] "\n"
            # Lex strings with escapes before punctuation; braces inside strings
            # cannot change object boundaries. Works with compact JSON as well.
            for (i = 1; i <= length(s);) {
                c = substr(s,i,1)
                if (c ~ /[[:space:]]/) { i++; continue }
                start = i++
                if (c == "\"") {
                    while (i <= length(s)) {
                        c = substr(s,i++,1)
                        if (c == "\\") i++
                        else if (c == "\"") break
                    }
                } else if (!index("[]{}:,", c)) {
                    while (i <= length(s) && substr(s,i,1) !~ /[[:space:]]/ && !index("[]{}:,", substr(s,i,1))) i++
                }
                tok[++nt] = substr(s,start,i-start); pos[nt] = start; size[nt] = i-start
            }
            gui = member(member(1,"data"),"GUI")
            order = member(gui,"childorder"); children = member(gui,"children")
            if (!gui || tok[order] != "[" || tok[children] != "{") exit 1
            found = 0
            for (i = order+1; i < skip(order)-1; i++)
                if (tok[i] == "\"SoundSwitchViewEnabled\"") found = 1
            if (!found) add[pos[order]+1] = "\"SoundSwitchViewEnabled\"" (tok[order+1] == "]" ? "" : ",")
            lighting = member(children,"SoundSwitchViewEnabled")
            if (lighting) {
                value = member(lighting,"state")
                if (!value || tok[value] !~ /^(true|false)$/) exit 1
                add[pos[value]] = state; remove[pos[value]] = size[value]
            } else {
                add[pos[children]+1] = "\"SoundSwitchViewEnabled\":{\"state\":" state ",\"type\":1}" (tok[children+1] == "}" ? "" : ",")
            }
            for (i = 1; i <= length(s); i++) {
                if (i in add) printf "%s", add[i]
                if (i in remove) i += remove[i]-1
                else printf "%s", substr(s,i,1)
            }
        }' "$gui_state" > "$gui_state.tmp" && mv "$gui_state.tmp" "$gui_state"
        rm -f "$gui_state.tmp"
    fi
    # Engine 5.3.0 cannot ATTACH anything while its internal m.db reserves page bytes
    # (a `.recover`ed copy did): rebuild it with reserve 0 before Engine opens it.
    # Also run the once-per-library #246 MP3 beat-grid correction while Engine is stopped.
    guardian=${SC5000_ENGINE_GUARDIAN:-/usr/local/bin/engine-guardian}
    # A huge or locked m.db must not hold the splash screen forever.
    t=; ! command -v timeout >/dev/null 2>&1 || t="timeout 10"
    [ ! -x "$guardian" ] || $t "$guardian" --heal-mount "${SC5000_ENGINE_DATA_DIR:-/data/AppDataUser/AIR Music Technology/Engine}" --normalize-reserve --fix-mp3-grids --timeout 10s > /dev/null 2>&1 || :
    # Engine 5.3.0 sends a TIDAL client with no saved account (or a tokenless SSO
    # account) to the Engine DJ Profile login (#56, #159), and every EngineX service
    # runs on that client. With stored accessToken/refreshToken credentials Engine
    # logs in to the local gateway at start instead of timing out after 150 s.
    # Real TIDAL (scope=tidal) keeps the stock login.
    accounts=${SC5000_STREAMING_ACCOUNTS:-/data/StreamingAccounts.json}
    export T='"TIDAL": "{\"provider\":\"TIDAL\",\"providerType\":\"TIDAL\",\"accessToken\":\"enginex\",\"refreshToken\":\"enginex\"}"'
    # #224: an old settings file may retain scope=tidal after TIDAL is disabled.
    sources=$(sed -n 's/^sources=//p' "$UI/settings.conf" 2>/dev/null | tail -n 1)
    if grep -q '^sources=' "$UI/settings.conf" 2>/dev/null; then
        case ",$sources," in
            *,tidal,*) ;;
            *) sed '/^scope=tidal$/d' "$UI/settings.conf" > "$UI/settings.conf.tmp" &&
                mv "$UI/settings.conf.tmp" "$UI/settings.conf" ;;
        esac
    fi
    if ! grep -qx 'scope=tidal' "$UI/settings.conf" 2>/dev/null; then
        if grep -Eq '"TIDAL"[[:space:]]*:' "$accounts" 2>/dev/null && ! grep -E '"TIDAL"[[:space:]]*:' "$accounts" 2>/dev/null | grep -q 'accessToken'; then
            awk '{
                if ($0 ~ /"TIDAL"[[:space:]]*:/ && $0 !~ /accessToken/) {
                    comma = ($0 ~ /,[[:space:]]*$/) ? "," : ""
                    print "    " ENVIRON["T"] comma
                } else {
                    print
                }
            }' "$accounts" > "$accounts.tmp" && mv "$accounts.tmp" "$accounts"
        elif ! grep -q '"TIDAL"' "$accounts" 2>/dev/null; then
            if grep -q '"' "$accounts" 2>/dev/null; then
                awk '!d && (i = index($0, "{")) { $0 = substr($0, 1, i) "\n    " ENVIRON["T"] "," substr($0, i + 1); d = 1 } 1' "$accounts" > "$accounts.tmp"
            else
                printf '{\n    %s\n}\n' "$T" > "$accounts.tmp"
            fi
            mv "$accounts.tmp" "$accounts"
        fi
    fi
    # #49: the 4-deck layout (four_deck_waveform=1) makes Engine a non-player with a
    # "Left" (decks 1/3) and a "Right" (2/4) group, while the players' preset assignment
    # files drive the unnamed player group: PLAY, CUE and the wheel reached no deck. Each
    # start binds a copy for the deck's role (four_deck_role; the hook routes the audio):
    # auto (13 or 24 by player number), 12 LAYER 1<->2, 13 1<->3, 24 2<->4, 1 or 2
    # locked to that deck. The assignment
    # loader parses bindings, not handlers. Off: the stock files.
    assign=${SC5000_ASSIGNMENT_DIR:-/usr/Engine/AssignmentFiles/PresetAssignmentFiles}
    patched=${SC5000_ASSIGNMENT_PATCHED:-/run/sc5000-assignments}
    on=; ! grep -qx 'four_deck_waveform=1' "$UI/settings.conf" 2>/dev/null || on=1
    if [ -n "$on" ]; then
        state_dir=${SC5000_STATE_DIR:-/data/AppDataUser/AIR Music Technology/Engine/State}
        for state_file in "$state_dir/PlanckGuiState.json" "$state_dir/PlanckClientState.json"; do
            [ -f "$state_file" ] || continue
            cp -p "$state_file" "$state_file.tmp" || continue
            if awk '
                /"ShowLayerB"[[:space:]]*:[[:space:]]*\{/ { field="layer" }
                /"PlayerColor[34]"[[:space:]]*:[[:space:]]*\{/ { field="color" }
                field == "layer" { sub(/"state"[[:space:]]*:[[:space:]]*false/, "\"state\": true") }
                field == "color" { sub(/#ff000000/, "#ff02c63e") }
                /}/ { field="" }
                { print }
            ' "$state_file" > "$state_file.tmp"; then
                mv "$state_file.tmp" "$state_file"
            else
                rm -f "$state_file.tmp"
            fi
        done
    fi
    role=$(sed -n 's/^four_deck_role=//p' "$UI/settings.conf" 2>/dev/null | tail -n 1)
    case $role in
    12|13|24|34|1|2) ;;
    *) # FOOLPROOF INVARIANT (#49/#123): auto MUST map odd Player -> 13 and even Player -> 24 so linked SC5000 / Shadow Decks never cross-control each other. NEVER change auto to 12.
        state=${SC5000_PLANCK_STATE:-"/data/AppDataUser/AIR Music Technology/Engine/State/PlanckClientState.json"}
        n=$(grep -A1 '"Player": {' "$state" 2>/dev/null | sed -n 's/.*"string": "\([0-9]*\)".*/\1/p' | head -n 1)
        case $n in *[02468]) role=24 ;; *) role=13 ;; esac ;;
    esac
    [ -z "$on" ] || { mkdir -p "$patched" && echo "$role" > "$patched/role"; } # the UI hook reads it
    # The wheel display (jog screen: cover, platter ring, logo) followed the unnamed
    # group's ActiveDeck, which stays at an empty deck 1, so it showed the logo while
    # the deck it controls played. It also has only cover slots and ring positions
    # for decks 1 and 2: map those two slots to this role's decks.
    for f in "$assign"/JP07/JP07_Controller_Assignments.qml "$assign"/JP08/JP08_Controller_Assignments.qml \
        "$assign"/JP13/JP13_Controller_Assignments.qml "$assign"/JP14/JP14_Controller_Assignments.qml \
        "$assign"/JP07/JP07_Display_Assignments.qml "$assign"/JP13/JP13_Display_Assignments.qml; do
        [ -f "$f" ] || continue
        ! mountpoint -q "$f" || umount "$f" || continue
        [ -n "$on" ] || continue
        cat > "$patched/role.awk" <<'AWK'
BEGIN {
    group = (role == "24" || role == "2") ? "\"Right\"" : "\"Left\""
    if (role == "12" || role == "34") group = "Planck.getProperty(\"/GUI/Decks/DeckLeft/Layer\").translator.index === 0 ? \"Left\" : \"Right\""
    own = role == "12" || role == "34" || role == "1" || role == "2" # these replace the stock LAYER
    unit = "Config.device.isPlayer ? \"\" : "
    layer_group = (role == "12" || role == "34") ? "\"Left\"" : group
    decks = "(Config.device.isPlayer ? [1, 2] : " ((role == "24" || role == "2") ? "[2, 4]" : role == "12" ? "[1, 2]" : role == "34" ? "[3, 4]" : "[1, 3]") ")"
}
/"\/GUI\/Decks\/Deck\/ActiveDeck"/ {
    print "    // EngineX #49: 4-deck role " role ": the wheel display follows the deck this unit controls"
    sub(/"\/GUI\/Decks\/Deck\/ActiveDeck"/, "\"/GUI/Decks/Deck%1/ActiveDeck\".arg(" unit group ")")
}
/"\/GUI\/Decks\/Deck\/Layer"/ { sub(/"\/GUI\/Decks\/Deck\/Layer"/, "\"/GUI/Decks/Deck%1/Layer\".arg(" unit layer_group ")") }
/"\/Engine\/Deck%1\/AlbumArt"\.arg\(index \+ 1\)/ { sub(/index \+ 1/, decks "[index]") }
/parseInt\(assignment\.activeDeckIndex\) === index \+ 1/ { sub(/index \+ 1/, decks "[index]") }
/"\/Private\/Deck[12]\/MidiSamplePosition"/ {
    slot = /Deck1/ ? 0 : 1
    sub(/"\/Private\/Deck[12]\/MidiSamplePosition"/, "\"/Private/Deck%1/MidiSamplePosition\".arg(" decks "[" slot "])")
}
/positionItems\[parseInt\(assignment\.activeDeckIndex\) - 1\]/ {
    sub(/parseInt\(assignment\.activeDeckIndex\) - 1/, decks ".indexOf(parseInt(assignment.activeDeckIndex))")
}
/^import airAssignments / && (role == "12" || role == "34") && FILENAME ~ /Controller/ {
    print; print "import InputAssignment 0.1"; print "import OutputAssignment 0.1"; print "import Planck 1.0"; next
}
/^    Layer \{$/ && own { layer = 1; next }
layer {
    if ($1 == "note:") note = $2
    if ($0 != "    }") next
    layer = 0
    if ((role != "12" && role != "34") || note == "") next
    print "    ValueNoteAssignment { // EngineX #49: LAYER toggles DeckLeft's layer, which picks decks 1/2"
    print "        objectName: \"Layer\""
    print "        channel: globalConfig.midiChannel"
    print "        note: " note
    print "        output: IncDecValueOutput {"
    print "            target: PropertyTarget {"
    print "                path: \"/GUI/Decks/DeckLeft/Layer\""
    print "            }"
    print "            changeAmount: 1"
    print "            increaseValue: true"
    print "            roundRobin: true"
    print "        }"
    print "    }"
    next
}
/^        id: deckConfig$/ {
    print; print "        // EngineX #49: 4-deck role " role
    print "        name: Config.device.isPlayer ? \"\" : " group; next
}
{ print }
AWK
        p=$patched/${f##*/}
        awk -v role="$role" -f "$patched/role.awk" "$f" > "$p"
        if grep -q 'EngineX #49: 4-deck role' "$p"; then mount --bind "$p" "$f"; else rm -f "$p"; fi
    done
    ;;
post)
    [ ! -e "$UI/safe-mode" ] || exit 0
    # Engine's setup script has just set the GPU to performance. This also covers
    # boot, when a start request would merge with an already running tune job.
    "${SC5000_PERF_TUNE:-/usr/local/bin/sc5000-perf-tune}" >/dev/null 2>&1
    # Legacy launchers and the release gate call post after spawning Engine.
    # New launchers create this before exec, including internal crash retries.
    if [ ! -e "$UI/safe-mode" ] && [ ! -s "$UI/boot-token" ]; then begin_attempt; fi
    ;;
stop)
    if [ -e "$pre_mark" ]; then
        rm -f "$UI/running-sentinel"
        # systemd sets SERVICE_RESULT=success for a requested stop/restart; a crash
        # (exit-code, signal, core-dump, timeout) keeps counting towards safe-mode.
        if [ "${SERVICE_RESULT:-success}" = success ]; then
            rm -f "$UI/boot-count" "$UI/boot-token" "$UI/boot-ready" "$UI/last-crash" "$UI/boot-failures" "$UI/boot-window"
        else
            mkdir -p "$UI"
            [ -s "$UI/boot-count" ] || echo 1 > "$UI/boot-count"
            : > "$UI/last-crash"
        fi
    fi
    # The stock script exits 0 after these quit reasons, so Restart=on-failure never
    # brings Engine back and the deck hangs on "Shutting down...". FactoryReset only
    # gets here without a reboot when az01-update --erase-data failed (not on AC power);
    # UpdateFromFile when az01-update --file rejected the image (a corrupt or foreign
    # .img on a stick): the deck stayed on a black screen until power-cycled (BH-GC2-4).
    reason_file=${SC5000_QUIT_REASON_FILE:-/tmp/engine-quit-reason}
    case $(cat "$reason_file" 2>/dev/null) in
    AnalyticsChange) ;;
    FactoryReset|UpdateFromFile) [ "$(systemctl is-system-running 2>/dev/null)" != stopping ] || exit 0 ;;
    *) exit 0 ;;
    esac
    rm -f "$reason_file"
    systemctl start --no-block engine.service >/dev/null 2>&1 || true
    ;;
esac
exit 0
