# systemd EnvironmentFile syntax, not shell. No external disk is formatted.
# Optional override when multiple removable MMC slots exist:
# ENGINEX_FRONT_SD_DEVICE=mmcblk1
ENGINEX_INTERNAL_CACHE=/var/cache/enginex
# Executable adapter for the stock Engine mount notification protocol:
ENGINEX_STORAGE_NOTIFY=/usr/local/libexec/enginex-storage-notify
ENGINEX_ENGINE_GUARDIAN=/usr/local/bin/engine-guardian
ENGINEX_GUARDIAN_TIMEOUT=10s
