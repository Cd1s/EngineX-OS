# Match actual /proc/interrupts names and existing RT Engine thread comm names.
# Only SCHED_FIFO/SCHED_RR audio threads are moved to CPU0.
SC5000_AUDIO_IRQ_PATTERN=ffb20000|snd|alsa|i2s|spdif|audio
SC5000_AUDIO_THREAD_PATTERN=audio|alsa|jack
SC5000_GPU_IRQ_PATTERN=ffa30000
SC5000_IO_IRQ_PATTERN=ehci_hcd|ff540000|eth0
