[Unit]
Description=SC5000 On-Device Stream Sync & CPU3 Audio Analyzer Console
After=local-fs.target network.target data.mount

[Service]
Type=simple
Slice=sc5000-background.slice
CPUAffinity=3
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/local/bin/stream-sync --listen :8080 --cpu 3
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
