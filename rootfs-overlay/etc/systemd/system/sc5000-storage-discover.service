[Unit]
Description=SC5000 SD-first coldplug discovery
After=local-fs.target systemd-udev-trigger.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/sc5000-storage
ExecStart=/usr/local/bin/sc5000-storage-mount --discover
CPUAffinity=3
CPUWeight=10
IOWeight=10
Slice=sc5000-background.slice

[Install]
WantedBy=multi-user.target
