[Unit]
Description=SC5000 Rekordbox Zero-Scan & Pro DJ Link Bridge
After=local-fs.target network.target data.mount

[Service]
Type=simple
Slice=sc5000-background.slice
CPUAffinity=3
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/local/bin/rb-bridge --prolink
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
