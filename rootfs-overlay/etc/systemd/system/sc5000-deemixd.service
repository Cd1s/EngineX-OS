[Unit]
Description=SC5000 On-Device Deemix Downloader (CPU3 Isolated)
After=network.target data.mount

[Service]
Type=simple
Slice=sc5000-background.slice
CPUAffinity=3
Nice=19
IOSchedulingClass=idle
ExecStart=/data/sc5000-custom/bin/sc5000-deemixd -state-dir /data/sc5000-custom/state -download-dir /data/sc5000-custom/Stream
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
