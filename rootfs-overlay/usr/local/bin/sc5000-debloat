#!/bin/sh
# Idempotent Engine 5.0.4 patcher. --root permits offline staging and never
# executes hardware commands. No firmware/MCU, downloads or stems are removed.
set -eu
root=/
runtime=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --root) [ "$#" -ge 2 ] || exit 2; root=$2; shift 2 ;;
        --apply-runtime) runtime=1; shift ;;
        *) echo "usage: sc5000-debloat [--root ROOT] [--apply-runtime]" >&2; exit 2 ;;
    esac
done
[ -d "$root" ] || { echo 'root directory missing' >&2; exit 1; }
root=$(cd "$root" && pwd -P)
if [ "$root" != / ] && [ "$runtime" = 1 ]; then
    echo 'runtime changes require the live root' >&2; exit 2
fi
base=${root%/}
scripts=$base/usr/Engine/Scripts
if [ "$runtime" = 0 ]; then
if [ -f "$scripts/engine" ]; then
    sed -i -E 's@(az01-ethernet-speed[[:space:]]+)100([[:space:];]|$)@\11000\2@g' "$scripts/engine"
fi
if [ -f "$scripts/setup-prerequisites.sh" ]; then
    sed -i -E \
        -e 's@(set-irq-affinity.sh[[:space:]]+ffb20000[[:space:]]+)[0-9]+@\10@g' \
        -e 's@(set-irq-affinity.sh[[:space:]]+ffa30000[[:space:]]+)[0-9]+@\11@g' \
        -e 's@(set-irq-affinity.sh[[:space:]]+(ehci_hcd|ff540000|eth0)[[:space:]]+)[0-9]+@\12@g' \
        "$scripts/setup-prerequisites.sh"
fi
if [ -f "$scripts/setup-usb-gadget.sh" ]; then
    sed -i -E 's@(^|[;[:space:]])shift1([;[:space:]]|$)@\1shift 1\2@g' "$scripts/setup-usb-gadget.sh"
fi
# Guard the dangerous recovery command, preserving the rest of the vendor
# encryption sequence. Persistent downloads should use the SD cache instead.
if [ -f "$scripts/encrypt-fs.sh" ]; then
    sed -i -E 's@(^|[[:space:];|&])(/[^[:space:];|&]+/)?az01-update[[:space:]]+--erase-data([[:space:];|&]|$)@\1: --sc5000-automatic-erase-disabled\3@g' "$scripts/encrypt-fs.sh"
fi
if [ -d "$scripts" ]; then
    ln -sfn cleanup-JP07.sh "$scripts/cleanup"
fi
mkdir -p "$base/etc/systemd/system/engine.service.d" "$base/etc/systemd/journald.conf.d" "$base/etc/connman"
cat > "$base/etc/systemd/system/engine.service.d/override.conf" <<'CONF'
[Unit]
# The image's UI packs and version.txt are installed by this unit (az01_packer PREPARE).
Wants=sc5000-custom-prepare.service
After=sc5000-custom-prepare.service

[Service]
LimitCORE=0
ExecStopPost=
# The vendor script only calls connmanctl, which 5.0.4 does not ship (#33).
ExecStopPost=-/bin/sh -c 'command -v connmanctl >/dev/null || exit 0; exec /usr/Engine/Scripts/cleanup-JP07.sh'
# Here, not in 60-ui-hook.conf: the empty ExecStopPost= above would drop it.
ExecStopPost=-/etc/sc5000/engine-ui-guard stop
# Engine runs without HOME: Mesa falls back to /root/.cache and Qt to //.config,
# both on the read-only root (#25). RAM-backed, capped so the cache stays small.
Environment=HOME=/tmp/sc5000-engine-home MESA_SHADER_CACHE_MAX_SIZE=32M
# No QML disk cache, as before #25. Engine 5.3.0 forces its own one in /data anyway;
# the UI hook stamps each replaced qrc file with its content hash so that cache stays fresh.
Environment=QML_DISABLE_DISK_CACHE=1
ExecStartPre=/bin/mkdir -p -m 0700 /tmp/sc5000-engine-home
ExecStartPre=/usr/local/bin/sc5000-debloat --apply-runtime
CONF
cat > "$base/etc/systemd/journald.conf.d/sc5000.conf" <<'CONF'
[Journal]
Storage=volatile
RuntimeMaxUse=16M
CONF
# /etc/hosts matches exact names. The optional dnsmasq config also blocks
# subdomains on images using dnsmasq. Streaming CDN domains remain available.
# Never block the inmusicbrands.com apex: connman's online check resolves
# ipv4.connman.inmusicbrands.com and Wi-Fi spins forever when it fails.
hosts=$base/etc/hosts
touch "$hosts"
sed -i '/^0\.0\.0\.0 inmusicbrands\.com$/d' "$hosts"
for domain in logstash.inmusicbrands.com telemetry.inmusicbrands.com posthog.com app.posthog.com us.i.posthog.com eu.i.posthog.com us.posthog.com eu.posthog.com; do
    if ! grep -Fqx "0.0.0.0 $domain" "$hosts"; then
        printf '0.0.0.0 %s\n' "$domain" >> "$hosts"
    fi
done
# Domains are also enforced by the local DNS proxy when it is installed. Do not
# change the device's DHCP owner or resolver configuration without evidence.
mkdir -p "$base/etc/dnsmasq.d"
cat > "$base/etc/dnsmasq.d/sc5000-telemetry.conf" <<'CONF'
address=/logstash.inmusicbrands.com/0.0.0.0
address=/telemetry.inmusicbrands.com/0.0.0.0
address=/posthog.com/0.0.0.0
CONF
# Stock online check: Engine shows the Wi-Fi "!" until connman reaches ONLINE.
cat > "$base/etc/connman/main.conf" <<'CONF'
[General]
OnlineCheckIPv4URL = http://ipv4.connman.inmusicbrands.com/
EnableOnlineCheck = true
PreferredTechnologies=wifi,ethernet
CONF
mkdir -p "$base/etc/systemd/system/connman.service.d" "$base/etc/edisksd"
cat > "$base/etc/systemd/system/connman.service.d/disable_dhcp_retries.conf" <<'CONF'
[Service]
Environment="CONNMAN_DISCOVER_RETRIES=5"
CONF
# Dirty NTFS still mounts. HFS+ must stay read-only: hfsplus.ko on the 6.6 RT
# kernel oopses (mm/highmem.c:553) on the first write and corrupts the catalog.
cat > "$base/etc/edisksd/main.conf" <<'CONF'
[ntfs3]
DefaultMountOptions=force
CONF
fi # offline/staging patches
if [ "$runtime" = 1 ]; then
    # The kernel boots with rfkill.default_state=0, which blocks both radios.
    if command -v rfkill >/dev/null 2>&1; then rfkill unblock bluetooth wifi || :; fi
    if command -v az01-ethernet-speed >/dev/null 2>&1; then
        az01-ethernet-speed 1000 || az01-ethernet-speed 100 || :
    fi
    if command -v iw >/dev/null 2>&1; then iw dev wlan0 set power_save off || :; fi
    if [ -r /proc/interrupts ]; then
        for spec in ffb20000:0 ffa30000:1 ehci_hcd:2 ff540000:2 eth0:2; do
            name=${spec%:*}; cpu=${spec#*:}
            for irq in $(awk -v name="$name" 'index($0,name) && $1 ~ /^[0-9]+:$/ {sub(":", "", $1); print $1}' /proc/interrupts); do
                if [ -w "/proc/irq/$irq/smp_affinity_list" ]; then
                    printf '%s\n' "$cpu" > "/proc/irq/$irq/smp_affinity_list" || :
                elif [ -w "/proc/irq/$irq/smp_affinity" ]; then
                    printf '%x\n' "$((1 << cpu))" > "/proc/irq/$irq/smp_affinity" || :
                fi
                for comm in /proc/[0-9]*/comm; do
                    [ -r "$comm" ] || continue
                    IFS= read -r thread < "$comm" || continue
                    case "$thread" in irq/"$irq"-*)
                        pid=${comm%/comm}; pid=${pid##*/}
                        if command -v taskset >/dev/null 2>&1; then taskset -pc "$cpu" "$pid" >/dev/null || :; fi
                        if [ "$name" = ffb20000 ] && command -v chrt >/dev/null 2>&1; then chrt -f -p 99 "$pid" || :; fi
                        ;; esac
                done
            done
        done
    fi
fi
