#!/bin/sh
# One-time readers for upgrading pre-5.3.0.5 data to the current names.
legacy_data='/data/sc5000-custom' # Legacy release reader.
legacy_ui=$legacy_data/ui # Legacy UI settings reader.
legacy_hfs='/run/sc5000-hfs-views' # Legacy release reader.
legacy_suite='sc5000-suite' # Legacy release reader.
legacy_deemix='sc5000-deemixd' # Legacy release reader.
legacy_alsa='99-sc5000-custom.conf' # Legacy release reader.
legacy_dropin='99-sc5000.conf' # Legacy release reader.
legacy_deemix_unit='enginex-sc5000-deemixd.service' # Legacy release reader.
legacy_etc='/etc/sc5000' # Legacy release reader.
legacy_run='/run/sc5000' # Legacy release reader.
legacy_engine_mount='/sc5000-engine-script' # Old Engine-script bind source.
legacy_engine_script='/run/sc5000-engine-script' # Legacy release reader.
legacy_boot_converted='/run/sc5000-boot-converted' # Legacy release reader.
legacy_tz_newer='/run/sc5000-tz-newer' # Legacy release reader.
legacy_assignments='/run/sc5000-assignments' # Legacy release reader.
legacy_stemsd='sc5000-stemsd' # Legacy release reader.
legacy_lab='/root/build/sc5000-lab' # Legacy release reader.
legacy_api='/v1/sc5000' # Legacy release reader.
legacy_share='/usr/share/sc5000-custom' # Legacy release reader.
legacy_unit='sc5000' # Legacy release reader.
legacy_libexec="/usr/libexec/${legacy_data##*/}" # Legacy release reader.
legacy_bin="/usr/local/bin/$legacy_unit" # Legacy release reader.
legacy_packer='sc5000-custom*' # Legacy release reader.
# Read environment overrides passed by older updaters.
ENGINEX_CUSTOM=${ENGINEX_CUSTOM:-${SC5000_CUSTOM:-}}
ENGINEX_ALSA_OVERLAY=${ENGINEX_ALSA_OVERLAY:-${SC5000_ALSA_OVERLAY:-}}
ENGINEX_UI_SCALE=${ENGINEX_UI_SCALE:-${SC5000_UI_SCALE:-}}
unset SC5000_CUSTOM SC5000_ALSA_OVERLAY SC5000_UI_SCALE
export ENGINEX_UI_SCALE
[ "$ENGINEX_CUSTOM" != "$legacy_data" ] || ENGINEX_CUSTOM=


# Rewrites managed configuration bytes without changing JSON syntax or file modes.
migrate_file() {
    mf_file=$1
    [ -f "$mf_file" ] && [ ! -L "$mf_file" ] || return 0
    grep -q "$legacy_unit" "$mf_file" || grep -q 'SC5000_' "$mf_file" || return 0
    mf_tmp="${mf_file%/*}/.enginex-migrate.$$"
    cp -p "$mf_file" "$mf_tmp" || return 1
    sed -e "s|$legacy_data|/data/enginex|g" \
        -e "s|$legacy_deemix_unit|enginex-deemixd.service|g" \
        -e "s|$legacy_deemix\.service|enginex-deemixd.service|g" \
        -e "s|/run/$legacy_unit|/run/enginex|g" \
        -e "s|/tmp/$legacy_unit|/tmp/enginex|g" \
        -e "s|/etc/$legacy_unit|/etc/enginex|g" \
        -e "s|/v1/$legacy_unit|/v1/enginex|g" \
        -e "s|$legacy_unit\\.lan|enginex.lan|g" \
        -e "s|$legacy_unit-stems-|enginex-stems-|g" \
        -e 's|SC5000_UI_SCALE=|ENGINEX_UI_SCALE=|g' "$mf_file" > "$mf_tmp" || return 1
    if cmp -s "$mf_file" "$mf_tmp"; then rm -f "$mf_tmp"; else mv "$mf_tmp" "$mf_file"; fi
}

migrate_values() {
    [ ! -e "$new/.migrated-5.3.0.5" ] || return 0
    for mv_dir in "$new" "$new/ui" "$new/state" "$new/tailscale"; do
        [ -d "$mv_dir" ] && [ ! -L "$mv_dir" ] || continue
        for mv_file in "$mv_dir"/*.json "$mv_dir"/*.conf "$mv_dir"/*.env; do
            migrate_file "$mv_file" || return 1
        done
    done
    if [ -d "$new/mods-state" ] && [ ! -L "$new/mods-state" ]; then
        for mv_dir in "$new"/mods-state/*; do
            [ -d "$mv_dir" ] && [ ! -L "$mv_dir" ] || continue
            migrate_file "$mv_dir/.paused" || return 1
        done
    fi
    mv_accounts=/data/StreamingAccounts.json
    if [ -f "$mv_accounts" ] && [ ! -L "$mv_accounts" ]; then
        mv_tmp=/data/.enginex-accounts.$$
        cp -p "$mv_accounts" "$mv_tmp" || return 1
        # Only complete synthetic credential values are changed, including nested JSON strings.
        sed -e 's|\(["\\]\)'"$legacy_unit"'-token\(["\\]\)|\1enginex\2|g' \
            -e 's|\(["\\]\)'"$legacy_unit"'-refresh\(["\\]\)|\1enginex\2|g' "$mv_accounts" > "$mv_tmp" || return 1
        if cmp -s "$mv_accounts" "$mv_tmp"; then rm -f "$mv_tmp"; else mv "$mv_tmp" "$mv_accounts"; fi
    fi
    # Installed ALSA configuration is converted before the data alias disappears.
    for mv_dir in /data/system/var/overlay/lib/alsa/conf.d /data/system/var-lib/alsa/conf.d; do
        mv_old="$mv_dir/$legacy_alsa"
        [ -d "$mv_dir" ] && [ ! -L "$mv_dir" ] && [ -f "$mv_old" ] && [ ! -L "$mv_old" ] || continue
        grep -Eq "$legacy_unit|enginex_alsa_boot_hook" "$mv_old" || continue
        mv_tmp="$mv_dir/.enginex-alsa.$$"
        cp -p "$mv_old" "$mv_tmp" || return 1
        sed -e "s|$legacy_data|/data/enginex|g" -e "s|$legacy_unit|enginex|g" "$mv_old" > "$mv_tmp" || return 1
        [ -e "$mv_dir/99-enginex.conf" ] || mv "$mv_tmp" "$mv_dir/99-enginex.conf"
        rm -f "$mv_tmp" "$mv_old"
    done
    : > "$new/.migrated-5.3.0.5"
}

migrate_data() {
old=$legacy_data
new=/data/enginex
if [ -d "$old" ] && [ ! -L "$old" ]; then
    case $(readlink "$new" 2>/dev/null) in
    "${legacy_data##*/}" | "$legacy_data" | enginex) rm -f "$new" ;;
    esac
    if [ ! -e "$new" ] && [ ! -L "$new" ]; then
        mv "$old" "$new"
    elif [ -d "$new" ] && [ ! -L "$new" ]; then
        if [ -d "$old/ui" ] && [ ! -L "$old/ui" ] && [ -d "$new/ui" ] && [ ! -L "$new/ui" ]; then
            for e in "$old/ui"/*.conf "$old/ui"/*.json "$old/ui"/*.env; do
                [ -f "$e" ] && [ ! -L "$e" ] || continue
                [ -e "$new/ui/${e##*/}" ] || [ -L "$new/ui/${e##*/}" ] || mv "$e" "$new/ui/"
            done
        fi
        for e in "$old"/* "$old"/.[!.]*; do
            [ -e "$e" ] || [ -L "$e" ] || continue
            [ -e "$new/${e##*/}" ] || [ -L "$new/${e##*/}" ] || mv "$e" "$new/"
        done
        rmdir "$old" 2>/dev/null || mv "$old" "$new/legacy-data.$$"
    else
        echo 'migration: refusing an unrelated current data symlink' >&2
        return 1
    fi
fi
[ -e "$new" ] || [ -L "$new" ] || mkdir -p "$new"
[ -d "$new" ] && [ ! -L "$new" ] || return 1
migrate_values || return 1
if [ -L "$old" ]; then
    case $(readlink "$old") in enginex|"$new") rm -f "$old" ;; esac
fi
}

# Server migration inputs; read only by the documented operator procedure.
legacy_relay_unit='sc5000-deemix-relay.service'
legacy_relay_state='/var/lib/sc5000-relay'
legacy_stems_config='/etc/sc5000-stems'
legacy_stems_code='/opt/sc5000-stems'

# Previous image units, read by the boot sandbox only.
legacy_prepare_unit='sc5000-custom-prepare.service'
legacy_reset_unit='sc5000-custom-etc-reset.service'
legacy_image_deemix_unit='sc5000-deemixd.service'
