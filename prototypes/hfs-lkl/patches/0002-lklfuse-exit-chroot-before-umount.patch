diff --git a/tools/lkl/lklfuse.c b/tools/lkl/lklfuse.c
index 446966a12..9dc021203 100644
--- a/tools/lkl/lklfuse.c
+++ b/tools/lkl/lklfuse.c
@@ -31,8 +31,10 @@ struct lklfuse {
 	int part;
 	int ro;
 	int mb;
+	int orig_root_fd;
 } lklfuse = {
 	.mb = 64,
+	.orig_root_fd = -1,
 };
 
 #define LKLFUSE_OPT(t, p, v) { t, offsetof(struct lklfuse, p), v }
@@ -762,6 +764,13 @@ static int start_lkl(void)
 		goto out_halt;
 	}
 
+	lklfuse.orig_root_fd = lkl_sys_open("/", LKL_O_RDONLY | LKL_O_DIRECTORY, 0);
+	if (lklfuse.orig_root_fd < 0) {
+		ret = lklfuse.orig_root_fd;
+		fprintf(stderr, "can't open /: %s\n", lkl_strerror(ret));
+		goto out_umount;
+	}
+
 	ret = lkl_sys_chroot(mpoint);
 	if (ret) {
 		fprintf(stderr, "can't chdir to %s: %s\n", mpoint,
@@ -772,6 +781,10 @@ static int start_lkl(void)
 	return 0;
 
 out_umount:
+	if (lklfuse.orig_root_fd >= 0) {
+		lkl_sys_close(lklfuse.orig_root_fd);
+		lklfuse.orig_root_fd = -1;
+	}
 	lkl_umount_dev(lklfuse.disk_id, lklfuse.part, 0, 1000);
 
 out_halt:
@@ -785,10 +798,18 @@ static void stop_lkl(void)
 {
 	int ret;
 
-	ret = lkl_sys_chdir("/");
-	if (ret)
-		fprintf(stderr, "can't chdir to /: %s\n", lkl_strerror(ret));
-	ret = lkl_sys_umount("/", 0);
+	if (lklfuse.orig_root_fd >= 0) {
+		ret = lkl_sys_fchdir(lklfuse.orig_root_fd);
+		if (!ret)
+			ret = lkl_sys_chroot(".");
+		if (ret)
+			fprintf(stderr, "can't restore orig root: %s\n",
+				lkl_strerror(ret));
+	}
+	lkl_sys_close_range(0, ~0U, 0);
+	lklfuse.orig_root_fd = -1;
+	lkl_sys_sync();
+	ret = lkl_umount_dev(lklfuse.disk_id, lklfuse.part, 0, 5000);
 	if (ret)
 		fprintf(stderr, "failed to umount disk: %d: %s\n",
 			lklfuse.disk_id, lkl_strerror(ret));
