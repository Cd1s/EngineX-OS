[Unit]
Description=EngineX Deemix relay (credential relay only; downloads run on the deck)
Documentation=https://relay.example.com/
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/enginex-relay -listen 0.0.0.0:6595 -public https://relay.example.com -state /var/lib/enginex-relay
DynamicUser=yes
StateDirectory=enginex-relay
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
Nice=10
CPUQuota=300%
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
