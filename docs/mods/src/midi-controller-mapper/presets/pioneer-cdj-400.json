{
  "id": "pioneer-cdj-400",
  "name": "Pioneer CDJ-400",
  "vendor": "Pioneer DJ",
  "model": "CDJ-400",
  "version": "1.0.0",
  "description": "Pioneer CDJ-400 standard USB MIDI mode (PC MODE) preset for EngineX OS 4-deck internal Deck 3/4 control.",
  "match": {
    "alsaClientPatterns": [
      "CDJ-400",
      "Pioneer CDJ-400"
    ],
    "usbIds": [
      "08e4:0143"
    ]
  },
  "midiChannel": "any",
  "rateLimitHz": 60,
  "stormLimitPerSec": 2400,
  "malformedLimit": 16,
  "jog": {
    "modeDefault": "vinyl",
    "touchNote": 32,
    "scratchCc": 16,
    "pitchBendCc": 48,
    "encoding": "cdj_continuous_velocity",
    "centerValue": 64,
    "maxOffset": 63,
    "scratchSensitivitySecPerSec": 1.8,
    "pitchBendMaxAmount": 0.65,
    "pitchBendTimeoutMs": 120
  },
  "tempoSlider": {
    "cc": 29,
    "msbCc": 29,
    "lsbCc": null,
    "invert": false,
    "softTakeover": true,
    "pickupThreshold": 0.025,
    "neutralDeadband": 0.004
  },
  "controls": {
    "playPause": {
      "type": "note",
      "number": 0,
      "action": "toggle_play",
      "label": "Play / Pause (9n 00)"
    },
    "cue": {
      "type": "note",
      "number": 1,
      "action": "hold_cue",
      "label": "Cue (9n 01)"
    },
    "searchFwd": {
      "type": "note",
      "number": 2,
      "action": "seek_forward",
      "label": "Search >> (9n 02)"
    },
    "searchRev": {
      "type": "note",
      "number": 3,
      "action": "seek_backward",
      "label": "Search << (9n 03)"
    },
    "trackSearchNext": {
      "type": "note",
      "number": 4,
      "action": "track_next",
      "label": "Track Search >>| (9n 04)"
    },
    "trackSearchPrev": {
      "type": "note",
      "number": 5,
      "action": "track_prev",
      "label": "Track Search |<< (9n 05)"
    },
    "loopIn": {
      "type": "note",
      "number": 6,
      "action": "loop_in",
      "label": "Loop In / Realtime Cue (9n 06)"
    },
    "loopOut": {
      "type": "note",
      "number": 7,
      "action": "loop_out",
      "label": "Loop Out / Out Adjust (9n 07)"
    },
    "reloopExit": {
      "type": "note",
      "number": 8,
      "action": "reloop_exit",
      "label": "Reloop / Exit (9n 08)"
    },
    "tempoRange": {
      "type": "note",
      "number": 16,
      "action": "cycle_tempo_range",
      "label": "Tempo Range ±6/10/16/100% (9n 10)"
    },
    "masterTempo": {
      "type": "note",
      "number": 17,
      "action": "toggle_keylock",
      "label": "Master Tempo / Key Lock (9n 11)"
    },
    "jogMode": {
      "type": "note",
      "number": 18,
      "action": "toggle_vinyl_mode",
      "label": "Jog Mode Vinyl/CDJ (9n 12)"
    },
    "sync": {
      "type": "note",
      "number": 19,
      "action": "toggle_sync",
      "label": "Beat Sync (9n 13)"
    },
    "loopDivide": {
      "type": "note",
      "number": 22,
      "action": "loop_halve",
      "label": "Beat Loop Divide 1/2X (9n 16)"
    },
    "loopDouble": {
      "type": "note",
      "number": 23,
      "action": "loop_double",
      "label": "Beat Loop Double 2X (9n 17)"
    },
    "browsePush": {
      "type": "note",
      "number": 50,
      "action": "load_selected_track",
      "label": "Rotary Push / Load Track (9n 32)"
    },
    "backButton": {
      "type": "note",
      "number": 51,
      "action": "toggle_browse_view",
      "label": "Back / Toggle Browse View (9n 33)"
    },
    "browseEncoder": {
      "type": "cc",
      "number": 79,
      "encoding": "relative_center_64",
      "action": "browse_scroll",
      "label": "Rotary Selector Browse (Bn 4F)"
    }
  },
  "ledFeedback": {
    "supported": false,
    "note": "Pioneer CDJ-400 in standard USB MIDI mode (PC MODE) is transmit-only for button/LED states and does not illuminate hardware LEDs in response to incoming external MIDI Note/CC messages. Deck playback status, vinyl mode, and soft-takeover ▲▼ indicators are rendered directly on the SC5000 display.",
    "mappings": []
  }
}
